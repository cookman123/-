  最弱 20%          683      -0.401%(t=-15.39)        -0.243%(t=-6.40)
  20-40%          683      -0.004%(t= 0.53)        -0.025%(t= 0.32)
  40-60%          682      +0.076%(t= 4.18)        -0.031%(t=-1.85)
  60-80%          683      +0.187%(t=12.05)        +0.017%(t= 0.83)
